# OASIS Backend — Environment Variables (example)
# Copy to `.env` and fill in real values. Never commit the filled-in file.
# Every variable here is validated at startup by src/config/env.ts — if
# something required is missing or malformed, the process fails fast with a
# clear error instead of misbehaving at request time.

# --- Runtime ---
NODE_ENV=development
PORT=4000

# --- Database (Prisma) ---
DATABASE_URL=postgresql://oasis:oasis_dev_password@localhost:5432/oasis_dev

# --- Auth / JWT ---
# Generate real values with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Genuinely separate from JWT_ACCESS_SECRET — used as the HMAC key when
# hashing refresh/verification tokens before storage, not for signing a
# JWT (refresh tokens aren't JWTs). See src/modules/auth/token.util.ts.
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30

# --- CORS ---
# Comma-separated for more than one origin. In production this must be your
# real frontend origin(s) — the app refuses to start in production if this
# is still the localhost default or contains a wildcard (src/config/env.ts).
CORS_ORIGIN=http://localhost:3000

# --- Cloudflare R2 — PRIVATE bucket (lecture videos & notes; signed URLs only) ---
# Not used until Module 3/4 — validated now so config errors surface early.
R2_ACCOUNT_ID=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET_NAME=oasis-private-content

# --- Cloudflare R2 — PUBLIC/media bucket (thumbnails, avatars, logo, testimonial photos) ---
# Deliberately separate credentials from the private bucket above (NFR-SEC-10)
# so a misconfiguration on one can't expose the other.
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=oasis-public-media
R2_PUBLIC_CDN_BASE_URL=https://media.oasis.example.com

# --- Razorpay --- (not used until Module 7)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Enquiry (Contact Us) submission is public + unauthenticated, so it gets its
# own, stricter limit rather than sharing the general API limit above.
ENQUIRY_RATE_LIMIT_WINDOW_MS=3600000
ENQUIRY_RATE_LIMIT_MAX=5
# Auth endpoints (login, register, forgot-password, etc.) are also public
# and abuse-prone — tighter than the general limit, keyed by IP+email.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# --- Logging ---
LOG_LEVEL=info

# --- Frontend URL (used to build links in verification/reset emails) ---
FRONTEND_URL=http://localhost:3000

# --- Transactional email ---
# Leave SMTP_HOST unset to use the console-log transport (emails are logged,
# not sent — fine for local dev; see src/lib/email.ts). Set all four SMTP_*
# vars together once a real provider (e.g. Resend, SES) is provisioned.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=OASIS <no-reply@oasis.example.com>

# --- API documentation ---
# Swagger/OpenAPI UI at /api/v1/docs. Defaults to enabled everywhere
# (including production) since the same docs are what a future Android/iOS
# client consumes — set to false to disable for a given deployment.
SWAGGER_ENABLED=true
