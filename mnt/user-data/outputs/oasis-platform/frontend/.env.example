# OASIS Frontend — Environment Variables (example)
# Copy to `.env.local` and fill in real values. Never commit the filled-in file.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser — never put a
# secret behind that prefix.

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
